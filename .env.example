# =============================================================================
# DevBox runtime credentials — copy to .env and fill in what you use.
# =============================================================================
# .env is gitignored. Nothing here is ever baked into the image; these are read
# by compose at container start.
#
# BEST PRACTICE, IN ORDER:
#   1. OIDC / workload identity / SSO      — nothing to store, nothing to leak
#   2. A secret manager piped in at start  — export ANTHROPIC_API_KEY="$(pass show ...)"
#   3. This file                           — acceptable, but it is a plaintext
#                                            credential on your disk
#
# Never commit a filled-in copy. gitleaks runs in pre-commit and in CI.
# =============================================================================

# --- Self-hosted models (default backend) ----------------------------------
# From `terraform output devbox_env` in infra/gcp-models (docs/gcp-models.md).
# Sign in once inside the box: gcloud auth login --no-launch-browser
# The model API key is fetched from Secret Manager by `ai up`; set it here only
# if you cannot use Secret Manager.
DEVBOX_GCP_PROJECT=
DEVBOX_GCP_ZONE=
DEVBOX_MODELS_API_KEY=

# --- Ollama Cloud (alternative backend: `ai use ollama_cloud`) -------------
# Key from https://ollama.com/settings/keys. Empty = use the host's signed-in
# Ollama daemon instead (OLLAMA_BASE_URL).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://host.containers.internal:11434

# --- Optional providers ------------------------------------------------------
# Gemini free tier (fallback). Paid APIs are disabled in ai/models/models.yaml.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GitHub ------------------------------------------------------------------
# Use a FINE-GRAINED token scoped to exactly:
#   contents: read · pull_requests: write · issues: read · actions: read
# The GitHub MCP server runs in its own container so this never enters the
# DevBox process tree. See docs/mcp.md.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Cloud -------------------------------------------------------------------
# Prefer SSO/OIDC. AWS_SECRET_ACCESS_KEY is deliberately NOT listed here: if you
# find yourself wanting it, set up SSO instead.
AWS_PROFILE=
AWS_REGION=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- DevBox ------------------------------------------------------------------
# Match these to your host uid/gid so bind-mounted files are owned correctly.
DEV_UID=1000
DEV_GID=1000
DEVBOX_WORKSPACE_HOST=./workspace
TZ=UTC
