# ============================================================================
# .gitignore - Prevent Accidental Commits of Sensitive Data
# ============================================================================

# ============================================================================
# ENVIRONMENT & CONFIGURATION
# ============================================================================
.env
.env.local
.env.*.local
.env.*.production
config/secrets.yml
config/database.yml
secrets/

# ============================================================================
# CREDENTIALS & KEYS
# ============================================================================
*.key
*.pem
*.p12
*.pfx
*.crt
*.der
id_rsa
id_rsa.pub
*.pub
.ssh/
.aws/
.azure/
.gcp/
credentials.json
google-services.json

# ============================================================================
# API KEYS & TOKENS
# ============================================================================
*.apikey
*.token
*.secret
oauth_token
oauth2_token

# ============================================================================
# DATABASE FILES & CREDENTIALS
# ============================================================================
*.db
*.sqlite
*.sqlite3
database.yml
db/
*.sql

# ============================================================================
# IDE & EDITOR FILES
# ============================================================================
.vscode/
# ...but this repository SHIPS a curated VS Code configuration (§3): it is part
# of the DevBox, not a personal preference. Only genuinely per-user files stay
# ignored.
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.sublime-project
.sublime-workspace
*.sublime-settings
*.kate-swp
.#*
*#*#
.emacs.d/
.vim/
.netrwhist

# ============================================================================
# DEPENDENCIES
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
lerna-debug.log*

venv/
env/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/

vendor/
.bundle/
Gemfile.lock

# ============================================================================
# LOGS & TEMPORARY FILES
# ============================================================================
*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/
*.cache
.pytest_cache/
.coverage
htmlcov/
.tox/

# ============================================================================
# BUILD & COMPILED FILES
# ============================================================================
*.o
*.obj
*.class
*.pyc
*.pyo
*.pyd
*.so
*.dll
*.exe
*.out
*.app
dist/
build/
*.egg

# ============================================================================
# RUNTIME & PROCESS FILES
# ============================================================================
.pid
*.pid
.lock
*.lock
.run
node_modules/.bin/

# ============================================================================
# TESTING
# ============================================================================
coverage/
.nyc_output/
junit.xml
test-results/
.mocha
karma.conf.js.bak

# ============================================================================
# CONTAINER & CLOUD
# ============================================================================
.docker
docker-compose.override.yml
.dockerignore
# ...except ours, which is a build-context definition kept in lockstep with
# .containerignore so the image builds identically under podman and docker.
!.dockerignore
.kube/
.kubeconfig

# ============================================================================
# CI/CD
# ============================================================================
.github/workflows/secrets.yml
.circleci/config.backup
.travis.yml.bak

# ============================================================================
# MAC OS
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns

# ============================================================================
# WINDOWS
# ============================================================================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ============================================================================
# PROJECT SPECIFIC
# ============================================================================
# Add project-specific files below
# Example:
# .env.production
# private_data/
# secret_keys/

# -----------------------------------------------------------------------------
# AI Engineering DevBox
# -----------------------------------------------------------------------------
# Generated SBOMs and scan reports — reproducible, never committed.
sbom/
*.spdx.json
*.cdx.json
*.sarif

# Terraform example output
examples/terraform/generated/

# A local MCP registry overlay for org-specific servers (may hold endpoints).
mcp/servers.local.yaml

# Extra CA certificates are environment-specific and must not be committed.
config/ca-certificates/*.crt
config/ca-certificates/*.pem
!config/ca-certificates/README.md

# The template is committed; a filled-in .env never is.
!.env.example
