{
  "version": "0.2.0",
  // Debug configurations for the languages this box targets. Terraform has no
  // debugger — `devbox terraform check` and `terraform console` are the
  // equivalent tools, and they are wired up in tasks.json instead.
  "configurations": [
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${fileDirname}"
    },
    {
      "name": "Python: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-vv"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Go: debug package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}"
    },
    {
      "name": "Go: debug test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Node: current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Bash: current script",
      "type": "bashdb",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "terminalKind": "integrated"
    }
  ],
  "compounds": []
}
