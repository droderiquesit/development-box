# syntax-agnostic OCI Containerfile — builds with `podman build`, `buildah bud`
# or `docker build` with or without BuildKit. No RUN --mount, no heredocs.
# =============================================================================
# AI ENGINEERING DEVBOX — BASE IMAGE
# =============================================================================
# Contains only the slow-moving foundation:
#   * Ubuntu 24.04 LTS + core engineering utilities
#   * the non-root `dev` user and the directory layout
#   * language runtimes: Go, Node.js (LTS), Python 3.12 + uv
#   * the shell experience
#
# Everything that changes weekly (IaC tools, cloud CLIs, security scanners, AI
# clients, MCP servers) lives in the DevBox image built FROM this one. That split
# is what keeps day-to-day rebuilds to ~2 minutes instead of ~20, and it means a
# CVE in an AI CLI never forces a full toolchain rebuild.
#
#   podman build -f Containerfile.base -t ai-devbox-base:latest .
# =============================================================================

ARG BASE_IMAGE=docker.io/library/ubuntu
ARG BASE_TAG=24.04
FROM ${BASE_IMAGE}:${BASE_TAG}

# Re-declare so the values are visible in the build stage, not just in FROM.
ARG BASE_IMAGE
ARG BASE_TAG
ARG DEV_USER=dev
ARG DEV_UID=1000
ARG DEV_GID=1000
ARG FEATURE_SUDO=1
ARG APT_USE_HTTPS=1
# Build metadata (OCI annotations). Supplied by the Makefile / CI.
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG VERSION=dev

LABEL org.opencontainers.image.title="ai-devbox-base" \
      org.opencontainers.image.description="Base layer for the AI Engineering DevBox: OS, non-root user, Go/Node/Python runtimes" \
      org.opencontainers.image.source="https://github.com/droderiquesit/development-box" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}:${BASE_TAG}"

ENV DEBIAN_FRONTEND=noninteractive \
    DEV_USER=${DEV_USER} \
    DEV_UID=${DEV_UID} \
    DEV_GID=${DEV_GID} \
    FEATURE_SUDO=${FEATURE_SUDO} \
    APT_USE_HTTPS=${APT_USE_HTTPS} \
    DEVBOX_HOME=/opt/devbox

# --- layer 0: corporate / proxy CA certificates -----------------------------
# Enterprises almost always sit behind a TLS-inspecting egress proxy. Without its
# root CA in the trust store every apt/curl/go/npm call in the build fails with
# an opaque certificate error. Drop *.crt files into config/ca-certificates/.
#
# This must run before the first apt call and cannot use apt itself: the stock
# ubuntu image ships no trust store at all, so `apt install ca-certificates`
# over HTTPS is a chicken-and-egg. We seed the bundle by hand here; layer 1
# installs the real ca-certificates package and re-runs update-ca-certificates.
COPY config/ca-certificates/ /usr/local/share/ca-certificates/devbox/
RUN set -eu; \
    if ls /usr/local/share/ca-certificates/devbox/*.crt >/dev/null 2>&1; then \
      if command -v update-ca-certificates >/dev/null 2>&1; then \
        update-ca-certificates; \
      else \
        mkdir -p /etc/ssl/certs; \
        cat /usr/local/share/ca-certificates/devbox/*.crt >> /etc/ssl/certs/ca-certificates.crt; \
      fi; \
      echo "seeded $(ls /usr/local/share/ca-certificates/devbox/*.crt | wc -l) extra CA certificate file(s)"; \
    else \
      echo "no extra CA certificates supplied"; \
    fi

# --- layer 1: OS packages + user -------------------------------------------
# Copied separately from the rest so a change to, say, the AI config never
# invalidates the 90-second apt layer.
COPY scripts/lib/ /opt/devbox/scripts/lib/
COPY scripts/install/10-os-base.sh /opt/devbox/scripts/install/
RUN chmod +x /opt/devbox/scripts/install/*.sh && \
    /opt/devbox/scripts/install/10-os-base.sh

# Locale is only valid once locale-gen has run in layer 1, otherwise every
# subsequent RUN emits `setlocale: cannot change locale` noise.
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# --- layer 2: language runtimes ---------------------------------------------
COPY versions.yaml /opt/devbox/versions.yaml
COPY scripts/install/20-languages.sh /opt/devbox/scripts/install/
RUN chmod +x /opt/devbox/scripts/install/*.sh && \
    /opt/devbox/scripts/install/20-languages.sh

# --- layer 3: shell experience ----------------------------------------------
COPY config/shell/00-env.sh    /etc/devbox/shell.d/00-env.sh
COPY config/shell/10-aliases.sh /etc/devbox/shell.d/10-aliases.sh
COPY config/shell/20-prompt.sh  /etc/devbox/shell.d/20-prompt.sh
COPY config/shell/bashrc        /etc/skel/.bashrc
RUN install -d -m 0755 /etc/devbox/completions && \
    cp /etc/skel/.bashrc /home/${DEV_USER}/.bashrc && \
    chown ${DEV_UID}:${DEV_GID} /home/${DEV_USER}/.bashrc && \
    printf '%s\n' 'if [ -f "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi' \
      > /home/${DEV_USER}/.bash_profile && \
    chown ${DEV_UID}:${DEV_GID} /home/${DEV_USER}/.bash_profile && \
    ln -sf /etc/devbox/shell.d/00-env.sh /etc/profile.d/00-devbox-env.sh

# The base image already runs unprivileged; the DevBox image inherits this.
USER ${DEV_USER}
WORKDIR /workspace
ENV HOME=/home/${DEV_USER}
SHELL ["/bin/bash", "-lc"]

# A base image with no toolchain still has to prove its runtimes work.
HEALTHCHECK --interval=1m --timeout=10s --start-period=5s --retries=2 \
  CMD go version >/dev/null && node --version >/dev/null && python3 --version >/dev/null || exit 1

CMD ["/bin/bash", "-l"]
