# shellcheck shell=bash
# -----------------------------------------------------------------------------
# ~/.bashrc for the DevBox development user.
# Drop-in files live in /etc/devbox/shell.d/ so modules can be added or removed
# without editing this file. Personal overrides go in ~/.bashrc.local (never
# overwritten by an image rebuild).
# -----------------------------------------------------------------------------

# Source the environment even for non-interactive shells so `podman exec` and
# VS Code tasks see the same PATH as a login terminal.
[ -r /etc/devbox/shell.d/00-env.sh ] && . /etc/devbox/shell.d/00-env.sh

case $- in *i*) ;; *) return ;; esac   # everything below is interactive-only

for f in /etc/devbox/shell.d/*.sh; do
  case "$(basename "$f")" in 00-env.sh) continue ;; esac
  [ -r "$f" ] && . "$f"
done

[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
for f in /etc/devbox/completions/*; do [ -r "$f" ] && . "$f"; done
unset f

command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"
command -v fzf    >/dev/null 2>&1 && eval "$(fzf --bash 2>/dev/null)"

# Show the banner once per interactive session, unless muted.
if [ -z "${DEVBOX_BANNER_SHOWN:-}" ] && [ "${DEVBOX_BANNER:-1}" = "1" ]; then
  export DEVBOX_BANNER_SHOWN=1
  [ -x /opt/devbox/bin/devbox ] && /opt/devbox/bin/devbox banner 2>/dev/null || true
fi

[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
